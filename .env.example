# ===================================================================
# IncidentOps Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your values
# All configuration is loaded from settings.yaml with ${VAR} interpolation
# All secrets MUST be set via environment variables

# ===================================================================
# Secrets (REQUIRED - must be set in environment)
# ===================================================================
OPENAI_API_KEY=sk-proj-your-key-here

# Gmail SMTP Configuration (for gmail.send tool)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password-here

# Pushover Configuration (for pushover.send tool)
PUSHOVER_API_TOKEN=your-pushover-api-token
PUSHOVER_USER_KEY=your-pushover-user-key

# Notification recipient (for testing)
GMAIL_RECIPIENT=your-email@example.com

# ===================================================================
# MCP Configuration (REQUIRED)
# ===================================================================
MCP_ENDPOINT=http://localhost:5005/send
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_RETRY_DELAY=2

# ===================================================================
# Runtime Configuration (REQUIRED)
# ===================================================================
LOG_LEVEL=INFO
ENABLE_HOOKS=true
SAVE_OUTPUT=true
USE_REAL_OPENAI=false

# ===================================================================
# Path Configuration (REQUIRED)
# ===================================================================
DATA_DIR=data/
OUTPUT_LOG_PATH=data/output/output_log.json

# ===================================================================
# Database Configuration (REQUIRED)
# ===================================================================
DB_PATH=data/db/incidents.db

# ===================================================================
# Notification Configuration (OPTIONAL)
# ===================================================================
# Comma-separated list of notification channels (e.g., gmail,pushover)
# Supported channels: gmail, pushover
# Leave empty if not using notification channels
NOTIFICATION_CHANNELS=
